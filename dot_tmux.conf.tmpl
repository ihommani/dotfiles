# Tmux Configuration
# Generated with TmuxAI Config Generator
# https://tmuxai.dev

# -- Basic Settings ------------------------------------------
set -g prefix C-b
set -g escape-time 500
set -g history-limit 5000
set -g base-index 1
setw -g pane-base-index 1
set -g mouse on

# -- Key Bindings ------------------------------------------

# Pane navigation
bind Left select-pane -L
bind Down select-pane -D
bind Up select-pane -U
bind Right select-pane -R

# -- Various --
# -- It's '^s' so we can still benefit from the 's' binding which list sessions ------
bind ^s set-window-option synchronize-panes \; display-message "Synchronize panes: #{?pane_synchronized, on, off}"

# -- Windowing --------------
bind c new-window -c '#{window_root}'
bind '"' split-window -v -c '#{pane_current_path}'
bind % split-window -h -c '#{pane_current_path}'

# -- Pane  ---------------------------------------------
# More intuitive pane rotation keybindings
bind-key r rotate-window -D  # Ctrl+b r to rotate clockwise
bind-key R rotate-window -U  # Ctrl+b R to rotate counterclockwise

# Reload config
bind C-r source-file ~/.tmux.conf \; display-message "Config reloaded"

# -- Status Bar ---------------------------------------------
set -g status-position bottom
set -g status-interval 5
set -g status-left "#{session_name} "
set -g status-left-length 50
set -g status-right "#{host} %Y-%m-%d %H:%M"
set -g status-right-length 50

# -- Clipboard ------------------------------------------
{{- if or (lookPath "wl-copy") (lookPath "xsel") (lookPath "xclip") }}
# Clipboard backend found: tmux-yank will drive it
set -g @yank_action 'copy-pipe-no-clear'
set -g @yank_with_mouse on
{{- else }}
# No clipboard backend on this host.
# Use SHIFT+drag to copy — the terminal (VTE/Ptyxis) bypasses tmux and
# writes directly to the local clipboard.
{{- end }}

# -- Plugins -----------------------------------------------
# Plugin manager
set -g @plugin 'tmux-plugins/tpm'

# Theme
set -g @plugin 'wfxr/tmux-power'

# Theme configuration
set -g @tmux_power_theme gold

# Other plugins
# -- I rather prefer to use tmuxp utility instead of tmux-resurrect and continuum
# set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-sensible'
{{- if or (lookPath "wl-copy") (lookPath "xsel") (lookPath "xclip") }}
set -g @plugin 'tmux-plugins/tmux-yank'
{{- end }}
# set -g @plugin 'tmux-plugins/tmux-continuum'

# Initialize TMUX plugin manager
# Keep this line at the very bottom of tmux.conf
run '~/.tmux/plugins/tpm/tpm'
